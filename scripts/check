#!/bin/sh
# Run every check. Run before each push; the pre-push hook does it too.
set -e
cd "$(dirname "$0")/.."
ruff check .
ruff format --check .
pytest -q
python scripts/check_docs.py
vale --minAlertLevel=error README.md CONTRIBUTING.md CHANGELOG.md SECURITY.md CLAUDE.md docs
echo "prose: no house-style errors (vale, errors only)"
python scripts/check_commits.py
