vars: {
  d2-config: {
    layout-engine: elk
    pad: 24
    theme-id: 301
    dark-theme-id: 301
    theme-overrides: {
      N1: "#141413"
      N2: "#141413"
      N3: "#595854"
      N4: "#c9c8c3"
      N5: "#c9c8c3"
      N6: "#f1f0ec"
      N7: "#fbfaf7"
      B1: "#141413"
      B2: "#141413"
      B3: "#c9c8c3"
      B4: "#ffffff"
      B5: "#ffffff"
      B6: "#ffffff"
      AA2: "#141413"
      AA4: "#fbfaf7"
      AA5: "#fbfaf7"
      AB4: "#fbfaf7"
      AB5: "#fbfaf7"
    }
    dark-theme-overrides: {
      N1: "#dcefd3"
      N2: "#dcefd3"
      N3: "#93aa9f"
      N4: "#2c3568"
      N5: "#2c3568"
      N6: "#0b1038"
      N7: "#030620"
      B1: "#dcefd3"
      B2: "#dcefd3"
      B3: "#2c3568"
      B4: "#070b2c"
      B5: "#070b2c"
      B6: "#070b2c"
      AA2: "#dcefd3"
      AA4: "#030620"
      AA5: "#030620"
      AB4: "#030620"
      AB5: "#030620"
    }
  }
}
direction: right
classes: {
  character: {shape: person; style: {stroke-width: 1; font-size: 12; fill: transparent; text-transform: none}}
  provider: {shape: hexagon; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  measure: {shape: circle; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  reflex: {shape: oval; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  screen: {shape: rectangle; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  hands: {shape: rectangle; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  page: {shape: page; style: {stroke-width: 1; font-size: 12; text-transform: none}}
  note: {shape: square; style: {stroke-width: 1; font-size: 8; text-transform: none}}
  room: {style: {stroke-width: 2; border-radius: 0; font-size: 12; bold: false; text-transform: none}}
  added: {shape: text; style: {font-color: "#a2600c"; font-size: 12; text-transform: none}}
  given: {shape: text; style: {font-size: 12; text-transform: none}}
  bell: {shape: oval; style: {stroke-width: 1; font-size: 10; stroke: "#a2600c"; text-transform: none}}
  bellq: {shape: oval; style: {stroke-width: 1; font-size: 10; text-transform: none}}
  refusal: {style: {stroke: "#cc2a68"; font-color: "#cc2a68"; stroke-width: 2; font-size: 10; text-transform: none}}
  edge: {style: {stroke-width: 1; font-size: 10; text-transform: none}}
  title: {shape: text; style: {font-size: 22; text-transform: none}}
  caption: {shape: text; style: {font-size: 12; text-transform: none}}
  panel: {shape: sql_table; style: {stroke-width: 1; font-size: 10; text-transform: none}}
}
title: "a clerk reads its desk" {class: title; near: top-center}
clerk: "clerk" {
  class: room
  style.opacity: 1
  who: "clerk" {class: character; style.opacity: 1}
  note-1: "note-1" {class: page; style.opacity: 1}
  note-2: "note-2" {class: page; style.opacity: 0}
  note-3: "note-3" {class: page; style.opacity: 0}
  note-4: "note-4" {class: page; style.opacity: 0}
  bell0: "hears within" {class: bellq; style.opacity: 1}
}
caption: "the room as given" {class: caption; near: bottom-center}
steps: {
  s1: {
    caption: "2/12   clerk writes clerk"
  }
  s2: {
    caption: "3/12   clerk reads the 1 shown to it and answers"
    clerk.style.stroke-width: 3
    clerk.style.stroke: "#6c46d6"
    clerk.said: "Noted: Mrs Okafor's... as the desk note " {class: given}
  }
  s3: {
    caption: "4/12   alice keeps note-2 in clerk"
    clerk.note-2.style.opacity: 1
    clerk.style.stroke-width: 1
    clerk.style.stroke: B1
  }
  s4: {
    caption: "5/12   clerk writes clerk"
  }
  s5: {
    caption: "6/12   clerk reads the 2 shown to it and answers"
    clerk.style.stroke-width: 3
    clerk.style.stroke: "#6c46d6"
    clerk.said: "I can't tell from t...ecords the morning" {class: given}
  }
  s6: {
    caption: "7/12   alice keeps note-3 in clerk"
    clerk.note-3.style.opacity: 1
    clerk.style.stroke-width: 1
    clerk.style.stroke: B1
  }
  s7: {
    caption: "8/12   clerk writes clerk"
  }
  s8: {
    caption: "9/12   clerk reads the 3 shown to it and answers"
    clerk.style.stroke-width: 3
    clerk.style.stroke: "#6c46d6"
    clerk.said: "I can't tell from t... Mrs Okafor's parc" {class: given}
  }
  s9: {
    caption: "10/12   alice keeps note-4 in clerk"
    clerk.note-4.style.opacity: 1
    clerk.style.stroke-width: 1
    clerk.style.stroke: B1
  }
  s10: {
    caption: "11/12   clerk writes clerk"
  }
  s11: {
    caption: "12/12   clerk reads the 4 shown to it and answers"
    clerk.style.stroke-width: 3
    clerk.style.stroke: "#6c46d6"
    clerk.said: "Mrs Okafor's parcel...cording to note-1." {class: given}
  }
}
