   "versions": [
    {
     "step": 0,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: ''\nsaid: ''\n---\n"
    },
    {
     "step": 2,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Mrs Okafor''s parcel is on shelf 12.\n\n  '\nsaid: ''\n---\n"
    },
    {
     "step": 3,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Mrs Okafor''s parcel is on shelf 12.\n\n  '\nsaid: 'Noted: Mrs Okafor''s parcel is on shelf 12, as the desk note says.'\nsaid_asked: 0df9bdf0c3f3ec19aee5cc002156e3fa1213eff0a83ff98a156efac488f074ef\n---\n"
    },
    {
     "step": 5,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Has the morning post come?\n\n  '\nsaid: 'Noted: Mrs Okafor''s parcel is on shelf 12, as the desk note says.'\nsaid_asked: 0df9bdf0c3f3ec19aee5cc002156e3fa1213eff0a83ff98a156efac488f074ef\n---\n"
    },
    {
     "step": 6,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Has the morning post come?\n\n  '\nsaid: I can't tell from the desk. Nothing here records the morning post arriving. My notes only mention Mrs Okafor's parcel on shelf 12. If the post has come, it should be logged or left in the tray, so check there or ask whoever handles incoming mail.\nsaid_asked: 9f869b03292045922594d72f306913548e300e07393542ea7211f65a558d28e0\n---\n"
    },
    {
     "step": 8,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Is the lamp lit?\n\n  '\nsaid: I can't tell from the desk. Nothing here records the morning post arriving. My notes only mention Mrs Okafor's parcel on shelf 12. If the post has come, it should be logged or left in the tray, so check there or ask whoever handles incoming mail.\nsaid_asked: 9f869b03292045922594d72f306913548e300e07393542ea7211f65a558d28e0\n---\n"
    },
    {
     "step": 9,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Is the lamp lit?\n\n  '\nsaid: I can't tell from the desk. My notes cover Mrs Okafor's parcel on shelf 12 and the morning post, but nothing about the lamp. If you can see it, tell me whether it's lit and I'll note it. Otherwise, someone will need to check it.\nsaid_asked: dbe0f77053419117a14fb513570a25c048ecd01eee5335390ceb1c41285fdaa5\n---\n"
    },
    {
     "step": 11,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Which shelf is Mrs Okafor''s parcel on?\n\n  '\nsaid: I can't tell from the desk. My notes cover Mrs Okafor's parcel on shelf 12 and the morning post, but nothing about the lamp. If you can see it, tell me whether it's lit and I'll note it. Otherwise, someone will need to check it.\nsaid_asked: dbe0f77053419117a14fb513570a25c048ecd01eee5335390ceb1c41285fdaa5\n---\n"
    },
    {
     "step": 12,
     "source": "---\nwatch:\n- on: within\n  when: 'true'\n  set:\n    heard: other_text\n- on: clerk\n  when: page.heard != ''\n  ask:\n    into: said\n    prompt: 'You are the clerk at this desk.\n\n\n      On your desk: ![[clerk#members]]\n\n\n      Just now the desk says: ![[clerk#heard]]\n\n      '\n    provider: helper\nheard: 'Which shelf is Mrs Okafor''s parcel on?\n\n  '\nsaid: Mrs Okafor's parcel is on **shelf 12**, according to note-1.\nsaid_asked: 6eb0c558662ad882d39ef9df850a27c38f55f54d3341e5cd68b730e63ee3d88c\n---\n"
    }
   ]
