    note-40: "40" {class: note; style.opacity: 0}
  }
  bell0: "hears within" {class: bellq; style.opacity: 1}
}
caption: "the room as given" {class: caption; near: bottom-center}
steps: {
  s1: {
    caption: "2/5   clerk writes clerk"
  }
  s2: {
    caption: "3/5   clerk reads the 8 shown to it and answers"
    clerk.style.stroke-width: 3
    clerk.style.stroke: "#6c46d6"
    clerk.said: "The desk notes don'...ng post has come. " {class: given}
  }
  s3: {
    caption: "4/5   alice keeps 18 pages in clerk"
    clerk.desk.note-23.style.opacity: 1
    clerk.desk.note-24.style.opacity: 1
    clerk.desk.note-25.style.opacity: 1
    clerk.desk.note-26.style.opacity: 1
