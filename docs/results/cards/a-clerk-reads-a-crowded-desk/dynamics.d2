vars: {
  d2-config: {
    layout-engine: elk
    pad: 24
    theme-id: 301
    dark-theme-id: 301
    theme-overrides: {
      N1: "#141413"
      N2: "#141413"
      N3: "#595854"
      N4: "#c9c8c3"
      N5: "#c9c8c3"
      N6: "#f1f0ec"
      N7: "#fbfaf7"
      B1: "#141413"
      B2: "#141413"
      B3: "#c9c8c3"
      B4: "#ffffff"
      B5: "#ffffff"
      B6: "#ffffff"
      AA2: "#141413"
      AA4: "#fbfaf7"
      AA5: "#fbfaf7"
      AB4: "#fbfaf7"
      AB5: "#fbfaf7"
    }
    dark-theme-overrides: {
      N1: "#dcefd3"
      N2: "#dcefd3"
      N3: "#93aa9f"
      N4: "#2c3568"
      N5: "#2c3568"
      N6: "#0b1038"
      N7: "#030620"
      B1: "#dcefd3"
      B2: "#dcefd3"
      B3: "#2c3568"
      B4: "#070b2c"
      B5: "#070b2c"
      B6: "#070b2c"
